{
  "name": "the-quiet-atlas",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check:bundle": "node tools/check-bundle/index.mjs out",
    "check:leaks": "node tools/scan-leaks/index.mjs src/content out",
    "check:licenses": "node tools/check-licenses/index.mjs",
    "check:gitleaks": "node tools/checks/gitleaks.mjs",
    "check:terraform": "node tools/checks/terraform.mjs",
    "serve:out": "node tools/serve-out/index.mjs out",
    "test:e2e": "playwright test",
    "test:perf": "playwright test -c tests/perf/playwright.perf.config.ts",
    "perf:lhci": "lhci autorun",
    "build:cv": "node tools/cv/index.mjs",
    "build:og": "node tools/og/index.mjs",
    "build:artifacts": "pnpm build && pnpm build:cv && pnpm build:og",
    "check:cv": "node tools/cv/verify.mjs && node tools/cv/check-output.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.21.0",
    "@react-three/fiber": "9.8.2",
    "next": "16.4.4",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource/noto-serif": "5.3.0",
    "@lhci/cli": "0.15.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.4",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
